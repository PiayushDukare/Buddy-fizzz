# Buddy Fizz — environment configuration TEMPLATE
# 1. Copy this file to ".env"  (same folder, or one level ABOVE the web root on Hostinger)
# 2. Fill in the real values below
# 3. NEVER commit .env to git / never upload it to a public folder
# Values with spaces don't need quotes, but you may wrap them in "double quotes".

# ── Database ─────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=buddyfizz
DB_USER=root
DB_PASS=

# ── App ──────────────────────────────────────────────────
# true only for local development (shows detailed errors). Keep false in production.
APP_DEBUG=false

# ── Email / Gmail SMTP ───────────────────────────────────
# Enable 2-Step Verification on the Gmail account, then create an App Password
# (Google Account -> Security -> App passwords) and paste the 16 chars (no spaces).
MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
# On shared hosting (Hostinger) SSL on 465 is the most reliable. STARTTLS on 587 also works.
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=yourbrand@gmail.com
SMTP_PASS=
SMTP_FROM=yourbrand@gmail.com
SMTP_FROM_NAME=Buddy Fizz
# Every outgoing mail is BCC'd here (blank = use the company_email setting)
MAIL_BCC=
# Set to false only if your host's certificate chain blocks the TLS handshake.
MAIL_VERIFY_PEER=true

# ── Razorpay payment gateway ─────────────────────────────
# Dashboard -> Settings -> API Keys. Use test keys (rzp_test_...) first.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
